{
	"name": "pexisgle.dev",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "husky && ts-patch install && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.5.0",
		"@types/three": "^0.183.1",
		"@typia/unplugin": "^12.0.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"flowbite": "^4.0.1",
		"flowbite-svelte": "^1.33.0",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sass": "^1.98.0",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"svelte-meta-tags": "^4.5.2",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.2.2",
		"ts-patch": "^4.0.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.58.0",
		"vite": "^8.0.3",
		"wrangler": "^4.78.0"
	},
	"dependencies": {
		"@cartamd/plugin-code": "^4.2.0",
		"@cartamd/plugin-emoji": "^4.3.0",
		"@cartamd/plugin-slash": "^4.2.0",
		"@iconify/svelte": "^5.2.1",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@octokit/rest": "^22.0.1",
		"arctic": "^3.7.0",
		"carta-md": "^4.11.1",
		"gray-matter": "^4.0.3",
		"gsap": "^3.14.2",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.0",
		"ress": "^5.0.2",
		"svelte-exmarkdown": "^5.0.2",
		"three": "^0.183.2",
		"typia": "^12.0.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	}
}
