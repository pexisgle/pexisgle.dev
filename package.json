{
	"name": "pexisgle.dev",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bun run build && wrangler dev --port 5173",
		"prepare": "ts-patch install && husky && bunx --bun svelte-kit sync || echo ''",
		"check": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bunx --bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/bun": "^1.3.10",
		"@types/three": "^0.183.1",
		"@typia/unplugin": "^12.0.1",
		"dotenv": "^17.3.1",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"flowbite": "^4.0.1",
		"flowbite-svelte": "^1.31.0",
		"flowbite-svelte-admin-dashboard": "^2.1.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.4.0",
		"highlight.js": "^11.11.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"ress": "^5.0.2",
		"sass": "^1.98.0",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.1",
		"ts-patch": "^3.3.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^8.0.0",
		"wrangler": "^4.75.0"
	},
	"dependencies": {
		"@cartamd/plugin-code": "^4.2.0",
		"@cartamd/plugin-emoji": "^4.3.0",
		"@cartamd/plugin-slash": "^4.2.0",
		"@jsquash/resize": "^2.1.1",
		"@jsquash/webp": "^1.5.0",
		"@octokit/rest": "^22.0.1",
		"arctic": "^3.7.0",
		"carta-md": "^4.11.1",
		"dayjs": "^1.11.20",
		"gray-matter": "^4.0.3",
		"gsap": "^3.14.2",
		"rehype-highlight": "^7.0.2",
		"svelte-exmarkdown": "^5.0.2",
		"svelte-meta-tags": "^4.5.0",
		"three": "^0.183.2",
		"typia": "^12.0.1"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	}
}
